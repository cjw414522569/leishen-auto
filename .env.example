# 雷神加速器账户配置
# 请将此文件复制为 .env 并填入你的实际值

# ============ 单个账户（不带编号的写法）============
PHONE=
# 密码是可选的。密码登录接口已被官方 WAF 封停，账户靠令牌缓存 + 短信登录工作，
# 所以只填手机号就够了。想留着也行，只是现在用不上。
PASSWORD=

# ============ 多账户（带编号的写法）============
# 编号从 1 开始、连续。空着不填的整组会被忽略，所以不需要的账户留着注释掉即可。
# 不带编号的 PHONE 与带编号的可以同时用，不带编号的排在前面。
PHONE_1=
PASSWORD_1=
# 该账户专属的推送 token（可选）。不填就回落到下面的全局 PUSHPLUS_TOKEN
PUSHPLUS_TOKEN_1=

PHONE_2=
PASSWORD_2=
PUSHPLUS_TOKEN_2=

# ============ 可选项 ============
# 通讯国家码，默认 86（中国大陆）。多账户共用这一个值
COUNTRY_CODE=
# 渠道来源，默认 guanwang
SRC_CHANNEL=
# 接口语言，默认 zh_CN
API_LANG=
# 单个请求的失败重试次数，默认 10（登录接口偶发“网络异常”：返回 200 但响应体为空）
# 两次重试之间会随机等 1~3 秒
RETRIES=
# 设为 1 时输出登录得到的 account_token（调试用）
SHOW_TOKEN=

# ============ 本地定时运行（仅本地运行有效）============
# 留空 = 跑一次就退出（默认）。填 cron 表达式就让进程常驻、到点跑一次
# 标准 5 段：分 时 日 月 星期。例：0 1 * * * 是每天凌晨 1 点
# 支持 *、N、N-M、N,M、*/N，月/星期也认 JAN-DEC / SUN-SAT
# 常驻期间令牌缓存会一直复用，不会每次都登录
RUN_CRON=

# 令牌缓存文件的位置。留空 = 项目根目录下的 .token_cache.json
# Docker 里指向挂载的卷，这样容器重建后不用重新登录
TOKEN_CACHE_FILE=

# ============ 失败重试（仅本地/Docker 常驻模式）============
# 某一轮失败后隔多久重试一次，默认 1h。填 0 = 关掉重试（失败就等下一个 cron 时刻）
# 支持 1h / 30m / 90s / 2d，不带单位按秒算
# 重试不会越过下一个 cron 时刻 —— cron 每天一次时最多重试 24 次
FAIL_RETRY_INTERVAL=
# 每失败几次推送一次，默认 5。第 1 次失败总是立刻推送，之后每 N 次推一次
FAIL_NOTIFY_EVERY=

# ============ 短信登录网页（令牌失效时推给你一个一次性地址）============
# 对外地址：**这是手机能不能打开那个地址的答案**。留空 = 不推送登录链接。
# 部署在服务器上就填服务器的公网地址，例如：
#   WEB_BASE_URL=https://lei.你的域名.com     ← 推荐，见下面关于 HTTPS 的说明
#   WEB_BASE_URL=http://1.2.3.4:8765
WEB_BASE_URL=
# 监听地址。默认：配了 WEB_BASE_URL 就 0.0.0.0，否则只在 127.0.0.1
# 想用反向代理（nginx 挂 HTTPS）时改成 127.0.0.1，让代理去对外
WEB_HOST=
# 监听端口，默认 8765
WEB_PORT=
# 注意：登录地址**只因被使用而失效，没有时间限制**。
# 登录成功后也可以在页面上直接输一个新手机号，它会自动追加到本文件里。

# ============ PushPlus 推送（可选）============
# 全局推送 token，留空则不推送。token 在 https://www.pushplus.plus 登录后于
# 「一对一推送」页面获取。账户配了 PUSHPLUS_TOKEN_n 时，那个账户用自己的
PUSHPLUS_TOKEN=
# 群组编码，填了就推给整个群组；留空只推给自己
PUSHPLUS_TOPIC=
# 消息模板，默认 txt（可选 html / markdown / json）
PUSHPLUS_TEMPLATE=
# 推送时机，默认 always：
#   always    —— 每次运行都推
#   on_change —— 只在真的有账户从「运行中」变成「已暂停」时推
# 注意：无论哪种模式，**失败一定推送**
NOTIFY_MODE=
# 推送条数，默认 combined：
#   combined    —— 发往同一个 token 的账户合成一条推送
#   per_account —— 一个账户一条推送
# 账户各自配了 PUSHPLUS_TOKEN_n 时，combined 也就是每账户一条了
NOTIFY_GROUPING=
