# 雷神加速器账户配置
# 请将此文件复制为 .env 并填入你的实际值

# ============ 单个账户（不带编号的写法）============
PHONE=
# 明文密码，程序会按接口要求自行做 MD5
PASSWORD=

# ============ 多账户（带编号的写法）============
# 编号从 1 开始、连续；每个账户的 PHONE_n 与 PASSWORD_n 必须成对出现。
# 空着不填的整组会被忽略，所以不需要的账户留着注释掉或留空即可。
# 不带编号的 PHONE 与带编号的可以同时用，不带编号的排在前面。
PHONE_1=
PASSWORD_1=

PHONE_2=
PASSWORD_2=

# ============ 可选项 ============
# 通讯国家码，默认 86（中国大陆）。多账户共用这一个值
COUNTRY_CODE=
# 渠道来源，默认 guanwang
SRC_CHANNEL=
# 接口语言，默认 zh_CN
API_LANG=
# 单个请求的失败重试次数，默认 10（登录接口偶发“网络异常”：返回 200 但响应体为空）
# 两次重试之间会随机等 1~3 秒
RETRIES=
# 设为 1 时输出登录得到的 account_token（调试用）
SHOW_TOKEN=

# ============ PushPlus 推送（可选）============
# 留空则不推送。token 在 https://www.pushplus.plus 登录后于「一对一推送」页面获取
PUSHPLUS_TOKEN=
# 群组编码，填了就推给整个群组；留空只推给自己
PUSHPLUS_TOPIC=
# 消息模板，默认 txt（可选 html / markdown / json）
PUSHPLUS_TEMPLATE=
# 推送时机，默认 always：
#   always    —— 每次运行都推
#   on_change —— 只在真的有账户从「运行中」变成「已暂停」时推
# 注意：无论哪种模式，**失败一定推送**
NOTIFY_MODE=
